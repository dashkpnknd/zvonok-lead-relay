[Unit]
Description=Zvonok lead relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zvonok
WorkingDirectory=/opt/zvonok-lead-relay
EnvironmentFile=/etc/zvonok-lead-relay.env
ExecStart=/usr/bin/python3 /opt/zvonok-lead-relay/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
